# links to FAQs in a directory

rm -f all_links.html
rm -f fu_2005/all_links.html
mkdir -p ed_2005

set flist = `grep -l ../../faq fu_2005/msg*.html`
foreach fname ( $flist )
  cp $fname ed_2005
  end

echo "< /body > < /html >" > all_links.html

set flist = `ls -1 ed_2005/msg*.html`

foreach fname ( $flist )
  echo " <p>$fname</p><br>" >> all_links.html
  grep -C 3 ../../faq $fname >> all_links.html
  echo "<p>-----</p><br>" >> all_links.html
  echo $fname
  end

# Move all_links.html to ed_2005.
# Edit out target="_blank". Fix links.

# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------

# Now the main documentation and any demos


rm -f all_links.html
rm -f fu_2005/all_links.html
mkdir -p ed_2005

echo "<html><body>" > all_links.html

set flist = `grep -l ../../documentation fu_2005/msg*.html`
foreach fname ( $flist )
  cp $fname ed_2005
  end

set flist = `grep -l ../../demos fu_2005/*.h
foreach fname ( $flist )
  cp $fname ed_2005
  end

set flist = `ls -1 ed_2005/msg*.html`
foreach fname ( $flist )
  echo " <p>$fname</p><br>" >> all_links.html
  grep -C 3 ../../documentation $fname >> all_links.html
  grep -C 3 ../../demos $fname >> all_links.html
  echo "<p>-----</p><br>" >> all_links.html
  echo $fname
  end

echo "< /body > < /html >" >> all_links.html



# Move all_links.html to ed_2005.
# Edit out target="_blank". Fix links.